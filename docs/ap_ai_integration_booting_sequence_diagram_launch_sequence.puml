@startuml
' 스타일 설정: 가독성을 위해 테마를 살짝 입힙니다.
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam DefaultFontName "Verdana"

title Robot Software (AI Node) Boot Sequence Framework

' 참여 객체 정의 (Participants)
actor "User" as User
participant "ROS 2 Launcher\n" as Launch
entity "<<CAM>> Camera\nUART or USB" as Camera
participant "ai_interface Node\n(Legacy UART AI Board)" as Node_uart_ai
participant "new_ai_pkg Node\n(Integrated AP Board AI)" as Node_new_ai
participant "error_monitor Node\n" as Node_error_monitor
participant "node_manager Node\n" as Node_node_manager

User -> Launch : **robot_bringup**
activate Launch
  == ROS 2 Node Launching (Parallel) ==
  par
    ' initialize nodes
    Launch -> Node_uart_ai : launch ai_interface (UART CAM)
    Launch -> Node_new_ai : launch new_ai_pkg (USB CAM)
    Launch -> Node_error_monitor : launch error_monitor
    Node_error_monitor -> Node_error_monitor : set default ai_mode (UART CAM)

    note right Node_node_manager #AntiqueWhite
      **[NOTE]**
      * Initialize error_monitor with default mode (UART CAM)
    end note

    Launch -> Node_node_manager : launch node_manager
    Node_node_manager -> Node_node_manager : set required node_list

    note right Node_node_manager #AntiqueWhite
      **[NOTE]**
      * Initialize node_manager with default mode
        - Postpone AI node monitoring until the preferred mode is identified.
    end note

    note right Node_node_manager #AntiqueWhite
      **[NOTE]**
      * Trigger all nodes via initial Launcher
    end note

    ' Legacy UART CAM
    loop timeout <color:red>90</color> sec
      Node_uart_ai -> Camera : try to comm w. camera
      break
        Node_uart_ai -> Node_uart_ai : <color:blue>**Success**</color> to connection Node <-> CAM
      end
    end

    alt success_to_connect == True
      Node_uart_ai -> Camera : parse cam data
      Node_uart_ai -> Node_error_monitor : publish topics (camera, temp, version)
    else
      Node_uart_ai -> Node_uart_ai : Stop trying to comm w. camera
    end

    note right Node_node_manager #LightCyan
      **[NOTE: UART (legacy)]**
      * //ai_interface// follows legacy behavior.
      * Topics (camera, temp, version) are published **only after** UART handshake.
      * Connection timeout: <color:red>90s</color> (Attempts stop after timeout).
    end note

    ' New USB CAM
    loop timeout <color:red>90</color> sec
      Node_new_ai -> Camera : try to comm w. camera
      break
        Node_new_ai -> Node_new_ai : <color:blue>**Success**</color> to connection Node <-> CAM
      end
    end

    alt success_to_connect == True
      Node_new_ai -> Camera : parse cam data
      Node_new_ai -> Node_new_ai : update AI version
      Node_new_ai -> Node_error_monitor : publish topics (camera, temp, version)
    else
      Node_new_ai -> Node_new_ai : set default version (AI Version: "0.0")
      Node_new_ai -> Node_new_ai : Stop trying to comm w. camera
    end

    note right Node_node_manager #LightCyan
      **[NOTE: USB (new)]**
      * if //new_ai_pkg// logic differs from legacy, follow these specs:
        - **Default Version:** <color:green>"0.0" (Used as a 'Not Connected' flag).</color>
        - **Update Trigger:** Update AI Version immediately upon successful connection.
          (//error_monitor// treats "0.0" as a connection failure)
      * Connection timeout: <color:red>90s</color> (Attempts stop after timeout).
    end note
      
    ' Check Activating Nodes (Error Monitor / Node Manager)
    loop timeout <color:red>120</color> sec
      Node_error_monitor -> Node_error_monitor : Listening for version topics...
      break
        Node_error_monitor -> Node_error_monitor : AI Version identified (version != "0.0")
      end
    end

    alt identified_mode == UART CAM (Legacy/Fallback)
      Node_error_monitor -> Node_error_monitor : Activate **F09-2** error monitor
      Node_error_monitor -> Node_node_manager : publish **ai_mode** (UART)
    else identified_mode == USB CAM (New)
      Node_error_monitor -> Node_error_monitor :Deactivate **F09-2** error monitor
      Node_error_monitor -> Node_node_manager : publish **ai_mode** (USB)
    end

    Node_error_monitor -> Node_error_monitor : File Writing AI version info to\n <color:blue>**"/home/airbot/app_rw/ai_mode.txt"**]
    Node_node_manager -> Node_node_manager : update required node_list\naccording to **ai_mode**

    note right Node_node_manager #LightCyan
      **[NOTE: ERROR MONITOR / NODE MANAGER]**
      * Dynamically selects AI mode based on incoming metadata.
      * Updates error/node monitoring policies based on version info from nodes
    end note
  end
  Launch -> User : terminated
deactivate Launch

@enduml