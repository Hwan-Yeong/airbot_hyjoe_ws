@startuml
' 스타일 설정: 가독성을 위해 테마를 살짝 입힙니다.
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam DefaultFontName "Verdana"

title Robot Software (AI Node) Boot Sequence Framework

' 참여 객체 정의 (Participants)
actor "User" as User
participant "Application Processor\n(Hardware/Kernel)" as AP
participant "systemd\n(Init System)" as Systemd
participant "robot.service\n" as Service
participant "robot-start\n" as Script
participant "ROS 2 Launcher\n" as Launch
participant "ai_interface Node\n(Legacy UART AI Board)" as Nodes_uart_ai
participant "new_ai_pkg Node\n(Integrated AP Board AI)" as Nodes_new_ai
participant "error_monitor Node\n" as Nodes_error_monitor
participant "node_manager Node\n" as Nodes_node_manager

== Phase 1: Low-Level Boot ==
' AP 부팅 및 커널 로드 과정
User -> AP : Power On
note over AP : Bootloader loads Kernel
AP -> AP : Kernel Initialization
AP -> Systemd : Start Init Process (PID 1)

== Phase 2: OS Service Management ==
' 시스템 데몬 및 서비스 시작
Systemd -> Systemd : Start System Daemons\n(Network, Udev, etc.)
activate Systemd
  Systemd -> Service : Execute **robot.service**
  activate Service
    == Phase 3: Application Entry ==
    ' 로봇 스크립트 실행 및 ROS 2 환경 구성
    Service -> Script : Execute **robot-start**
    activate Script
      note over Script
        source, export ...
        Set Environment Variables
      end note
      
      Script -> Launch : **robot_bringup**
      activate Launch
      
      == Phase 4: ROS 2 Node Launching (Parallel) ==
      ' 여러 노드가 동시에 실행되는 구간
      par
        Launch -> Nodes_uart_ai : launch ai_interface (UART CAM)
        Launch -> Nodes_new_ai : launch new_ai_pkg (USB CAM)
        Launch -> Nodes_error_monitor : launch error_monitor
        Nodes_error_monitor -> Nodes_error_monitor : set defualt ai_mode (UART CAM)
        Launch -> Nodes_node_manager : launch node_manager
        Nodes_node_manager -> Nodes_node_manager : set required node_list

        alt timeout < <color:red>90 sec</color> 
          Nodes_uart_ai -> Nodes_uart_ai : try to comm w. camera
          Nodes_uart_ai -> Nodes_error_monitor : publish topics\n(camera, temperature, version)
        else
          Nodes_uart_ai -> Nodes_uart_ai : Stop trying to comm w. camera
        end

        alt timeout < <color:red>90 sec</color>
          Nodes_new_ai -> Nodes_new_ai : try to comm w. camera

          alt succes_to_connect == true
            Nodes_new_ai -> Nodes_new_ai : update AI Version
          else 
            Nodes_new_ai -> Nodes_new_ai : set defualt version (AI Version: "0.0")
          end

          Nodes_new_ai -> Nodes_error_monitor : publish topics\n(camera, temperature, version)
        else
          Nodes_new_ai -> Nodes_new_ai : Stop trying to comm w. camera
        end
          
        ' 활성화 된 노드가 무엇인지 체크
        loop AI Version sub timeout < <color:red>120 sec</color>
          Nodes_error_monitor -> Nodes_error_monitor : activated node check,\nset identified ai_mode
          Nodes_error_monitor --> Nodes_error_monitor : both nodes are deactived,\nset default (legacy UART CAM)
        end
        Nodes_error_monitor -> Nodes_error_monitor : **F09-2** error Active/Deactive
        Nodes_error_monitor -> Nodes_node_manager : publish ai_mode
        Nodes_node_manager -> Nodes_node_manager : update required node_list\naccording to ai_mode
      end
      Launch --> Systemd : Service Stop
      deactivate Launch
    deactivate Script
    Script --> Systemd : Service Stop
  deactivate Service
  Service --> Systemd : Service Status: Running
deactivate Systemd

note right Nodes_node_manager
  **[NOTE]**
  * **Check for <color:red>race conditions</color>** on concurrent camera access.
  * Timeout - AI Mode Check **(60s)** < UDP Version Check **(120s)**
  * Consider //<color:red>"ai_node_selector_node"</color>// in //"node_manager pkg"//
     if **race conditions** occurs.
end note

@enduml