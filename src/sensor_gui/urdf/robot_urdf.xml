<?xml version="1.0" ?>
<robot name="clean_robot">

  <!-- Init colour -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="light_black"><color rgba="0.35 0.35 0.35 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.4235 0.0392 1.0"/></material>
  <material name="brown"><color rgba="0.8706 0.8118 0.7647 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>

  <!-- Body color : light_black, dark, grey ... -->
  <color_settings body_color="white" />

  <!-- Links -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </visual>
  </link>

  <link name="base_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.175" /></geometry>
      <material name="body_color"/>
    </visual>
  </link>

  <link name="body_support_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.02 0.03" /></geometry>
      <material name="body_color"/>
    </visual>
  </link>

  <link name="body_support_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.02 0.03" /></geometry>
      <material name="body_color"/>
    </visual>
  </link>

  <link name="body_top">
    <visual>
      <geometry>
        <barrel radius="0.175" center_radius="0.190" length="0.49" />
      </geometry>
      <material name="body_color"/>
    </visual>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.03" radius="0.05" /></geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.03" radius="0.05" /></geometry>
      <material name="black"/>
    </visual>
  </link>
  
  <link name="caster_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.018" /></geometry>
      <material name="white"/>
    </visual>
  </link>

  <link name="caster_rear_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.018" /></geometry>
      <material name="white"/>
    </visual>
  </link>
  
  <link name="imu_link"/>
  <link name="base_scan"/>

  <link name="base_scan_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.0176" /></geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="base_scan_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.0176" /></geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Joints -->
  <joint name="base_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_body"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  
  <joint name="body_support_joint_left" type="fixed">
    <parent link="base_link"/>
    <child link="body_support_left"/>
    <origin xyz="0 0.165 0.085" rpy="0 0 0"/>
  </joint>

  <joint name="body_support_joint_right" type="fixed">
    <parent link="base_link"/>
    <child link="body_support_right"/>
    <origin xyz="0 -0.165 0.085" rpy="0 0 0"/>
  </joint>

  <joint name="body_top_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_top"/>
    <origin xyz="0 0 0.345" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.122 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.122 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <!-- Positioned at X=0.135, Z=-(0.045 - 0.015) = -0.03 relative to wheel center / base_link -->
    <origin xyz="0.135 0 -0.03" rpy="0 0 0"/>
  </joint>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear_link"/>
    <origin xyz="-0.135 0 -0.03" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <joint name="scan_front_joint" type="fixed">
    <parent link="base_scan"/>
    <child link="base_scan_front"/>
    <origin xyz="0.1475 0 0" rpy="0 0 3.14"/>
  </joint>

  <joint name="scan_back_joint" type="fixed">
    <parent link="base_scan"/>
    <child link="base_scan_back"/>
    <origin xyz="-0.1475 0 0" rpy="0 0 0"/>
  </joint>

</robot>
