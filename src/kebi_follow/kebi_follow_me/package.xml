<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kebi_follow_me</name>
  <version>0.1.0</version>
  <description>Bringup (launch, parameters, docs) of the kebi follow-me stack</description>
  <maintainer email="hyjoe@everybot.net">hyjoe</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>kebi_follow_msgs</exec_depend>
  <exec_depend>kebi_follow_detector</exec_depend>
  <exec_depend>kebi_follow_tracker</exec_depend>
  <exec_depend>kebi_follow_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
